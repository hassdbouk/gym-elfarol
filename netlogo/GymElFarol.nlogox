<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[
extensions [ csv ]
__includes [ "preferences.nls" ]

;; Gym El Farol -- slot-based gym crowding model.
;; Strategy machinery (random-strategy, predict-attendance, update-strategies)
;; follows IABM chapter 3 El Farol (Rand & Wilensky 2007).
;; Seeded strategy generation and population-size scaling support reproducible runs.
;; Decision rule, information, and memory are the gym extension:
;;   each tick = one 30-min slot (31 slots = one weekday, 06:30-22:00);
;;   each agent wants one workout per day and chooses a slot or skips;
;;   history is kept per slot, in days; info-mode adds intra-day counts.

globals [
  attendance            ;; occupancy of the current slot (original name)
  history               ;; history of the slot now being decided (original name)
  slot-histories        ;; list of n-slots histories, each length memory-size * 2
  today-attendance      ;; occupancies already observed today
  current-slot          ;; 0 .. n-slots - 1
  current-day           ;; 1-based day counter
  n-slots               ;; slots in a day (31)
  slot-labels           ;; ["06:30" "07:00" ... "21:30"]
  seed-means            ;; list of per-slot series used to seed memory
  home-patches
  gym-patches
  crowded-patch
  clock-patch
  ;; post-burn-in accumulators for BehaviorSpace reporters
  all-slot-attendance
  n-slots-over
  n-slots-recorded
  n-good-visits
  n-visits
  n-skips
  n-agent-days
  peak-so-far
  availability-rules preference-rules flexibility-rules crowding-rules
  profile-rng model-rng profile-assignments
]

turtles-own [
  strategies            ;; bag of linear predictors (original)
  best-strategy         ;; currently selected strategy (original)
  attend?               ;; going to the gym this slot? (original)
  prediction            ;; predicted occupancy of this slot (original)
  decided?              ;; already went or skipped today
  went-today?
  skipped-today?
  good-visit?           ;; every occupied slot of this visit was at or under capacity
  availability-group time-preference flexibility-level crowding-preference
  slot-tie-priorities allowed-start-slots departure-slot visit-start-slot
]

to setup
  clear-all
  set-default-shape turtles "person"
  set n-slots 31
  set slot-labels n-values n-slots [ i -> slot-label-at i ]
  set current-slot 0
  set current-day 0
  set attendance 0
  set today-attendance []
  set all-slot-attendance []
  set n-slots-over 0
  set n-slots-recorded 0
  set n-good-visits 0
  set n-visits 0
  set n-skips 0
  set n-agent-days 0
  set peak-so-far 0

  set home-patches patches with [ pycor < 0 or (pxcor < 0 and pycor >= 0) ]
  ask home-patches [ set pcolor green ]
  set gym-patches patches with [ pxcor > 0 and pycor > 0 ]
  ask gym-patches [ set pcolor blue ]

  load-profile-rules
  build-profile-assignments
  random-seed simulation-seed
  load-seed-means
  set slot-histories map [ m -> make-slot-history m ] seed-means
  set history first slot-histories

  ask patch (0.75 * max-pxcor) (0.50 * max-pycor) [
    set crowded-patch self
    set plabel-color yellow
  ]
  ask patch (0.75 * max-pxcor) (0.75 * max-pycor) [
    set clock-patch self
    set plabel-color white
    set plabel first slot-labels
  ]

  create-turtles n-agents [
    set color white
    set decided? false
    set went-today? false
    set skipped-today? false
    set good-visit? false
    set attend? false
    set prediction 0
    move-to-empty-one-of home-patches
  ]
  foreach sort turtles [ agent ->
    ask agent [
      assign-profile
      set departure-slot -1
      set visit-start-slot -1
      set strategies n-values number-strategies [ random-strategy ]
      set best-strategy first strategies
      update-strategies
    ]
  ]
  reset-ticks
end

to go
  set current-slot ticks mod n-slots
  if current-slot = 0 [
    start-new-day
  ]
  if visualize? [
    ask crowded-patch [ set plabel "" ]
    ask clock-patch [ set plabel item current-slot slot-labels ]
  ]

  ;; swap this slot's per-day history into the original global so the
  ;; unchanged strategy procedures can see it
  set history item current-slot slot-histories

  ;; Depart before resolving this slot. All new decisions are simultaneous:
  ;; actual attendance is counted only after every agent has decided.
  ask turtles with [attend? and departure-slot <= current-slot] [ set attend? false ]
  ask turtles with [not decided? and willing-to-go?] [
    update-strategies
    set prediction predict-attendance best-strategy sublist history 0 memory-size
    set prediction apply-info-signal prediction
    if choose-now? prediction [
      set attend? true
      set decided? true
      set went-today? true
      set good-visit? true
      set visit-start-slot current-slot
      set departure-slot current-slot + workout-slots
    ]
  ]
  if current-slot = n-slots - 1 [
    ask turtles with [not decided?] [
      set skipped-today? true
      set decided? true
    ]
  ]

  ;; Patch movement is display-only. BehaviorSpace turns visualize? off so
  ;; the 3x3 / 30-seed grids are not dominated by empty-patch searches.
  if visualize? [
    ask turtles [
      ifelse attend?
        [ move-to-empty-one-of gym-patches ]
        [ move-to-empty-one-of home-patches ]
      update-color
    ]
  ]

  set attendance count turtles with [ attend? ]
  let over? attendance > capacity
  if over? [
    ask turtles with [attend?] [ set good-visit? false ]
  ]
  if visualize? and over? [
    ask crowded-patch [ set plabel "CROWDED" ]
  ]

  set history fput attendance but-last history
  set slot-histories replace-item current-slot slot-histories history
  set today-attendance lput attendance today-attendance
  record-metrics over?
  tick
end

to go-day
  repeat n-slots [ go ]
end

to start-new-day
  set current-day current-day + 1
  set today-attendance []
  ask turtles [
    set decided? false
    set went-today? false
    set skipped-today? false
    set good-visit? false
    set attend? false
    set departure-slot -1
    set visit-start-slot -1
    if visualize? [
      set color white
      move-to-empty-one-of home-patches
    ]
  ]
end

;; Intra-day information is blended with the inductive per-slot prediction.
;; none:    inductive prediction only (classic El Farol, that slot's past days)
;; live:    also see the actual count of the previous slot today
;; delayed: also see the count from `delay` slots ago (default 2 = 1 hour)
to-report apply-info-signal [base]
  if info-mode = "none" [ report base ]
  if current-slot = 0 [ report base ]
  if info-mode = "live" [
    report 0.5 * base + 0.5 * last today-attendance
  ]
  if info-mode = "delayed" [
    if current-slot < delay [ report base ]
    report 0.5 * base + 0.5 * item (current-slot - delay) today-attendance
  ]
  report base
end

to record-metrics [over?]
  if current-day <= burn-in-days [ stop ]
  set all-slot-attendance lput attendance all-slot-attendance
  set n-slots-recorded n-slots-recorded + 1
  if over? [ set n-slots-over n-slots-over + 1 ]
  if attendance > peak-so-far [ set peak-so-far attendance ]
  if current-slot = n-slots - 1 [
    set n-agent-days n-agent-days + count turtles
    set n-skips n-skips + count turtles with [ skipped-today? ]
    set n-visits n-visits + count turtles with [ went-today? ]
    set n-good-visits n-good-visits + count turtles with [ good-visit? ]
  ]
end

to update-color  ;; turtle procedure
  if attend? [ set color orange stop ]
  if went-today? [ set color yellow stop ]
  if skipped-today? [ set color gray stop ]
  set color white
end

to-report make-slot-history [slot-series]
  ifelse seed-from-data? [
    report cycle-fill slot-series (memory-size * 2)
  ] [
    report n-values (memory-size * 2) [ random n-agents ]
  ]
end

;; seed_history.csv is exported from data/params.json (demand_curve / seed_history)
;; by analysis/calibrate.py. NetLogo cannot read JSON, so the csv extension is the
;; bridge the plan asked for. Each row is one slot; weekday_scaled columns are
;; successive "past days" cycled into that slot's memory.
to load-seed-means
  ;; fallback = scaled weekday-pooled means from params.json seed_history
  set seed-means map [ m -> (list m) ] [ 10.48 10.48 15.38 13.25 13.59 15.12 14.18 16.28 19.18 19.27 21.80 22.15 23.90 23.56 27.51 26.71 26.06 26.88 29.15 27.97 30.58 30.05 31.32 28.80 28.78 26.72 25.80 24.59 26.87 22.70 26.23 ]
  let path seed-file-path
  if path = "" [ stop ]
  let rows csv:from-file path
  if length rows < 2 [ stop ]
  let header first rows
  let mean-col position "mean_occupancy_scaled" header
  if not is-number? mean-col [ stop ]
  let weekday-cols []
  foreach [ "monday_scaled" "tuesday_scaled" "wednesday_scaled" "thursday_scaled" "friday_scaled" ] [ name ->
    let col position name header
    if is-number? col [
      set weekday-cols lput col weekday-cols
    ]
  ]
  let loaded []
  foreach but-first rows [ row ->
    let series []
    foreach weekday-cols [ col ->
      if length row > col [
        let v coerce-number-or-none item col row
        if is-number? v [
          set series lput v series
        ]
      ]
    ]
    if empty? series and length row > mean-col [
      let v coerce-number-or-none item mean-col row
      if is-number? v [
        set series lput v series
      ]
    ]
    if not empty? series [
      set loaded lput series loaded
    ]
  ]
  if not empty? loaded [
    set seed-means pad-or-trim loaded n-slots
  ]
end

to-report seed-file-path
  ;; GUI uses the model directory; headless often uses the project root.
  if file-exists? "seed_history.csv" [
    report "seed_history.csv"
  ]
  if file-exists? "netlogo/seed_history.csv" [
    report "netlogo/seed_history.csv"
  ]
  if file-exists? "../data/processed/demand_curve.csv" [
    report "../data/processed/demand_curve.csv"
  ]
  if file-exists? "data/processed/demand_curve.csv" [
    report "data/processed/demand_curve.csv"
  ]
  report ""
end

;; label of slot i: 06:30 plus 30 minutes per slot ("06:30" ... "21:30")
to-report slot-label-at [i]
  let minutes 390 + 30 * i
  let h floor (minutes / 60)
  let m minutes mod 60
  report (word (ifelse-value (h < 10) [ "0" ] [ "" ]) h ":" (ifelse-value (m < 10) [ "0" ] [ "" ]) m)
end

to-report pad-or-trim [xs n]
  if empty? xs [ report xs ]
  if length xs >= n [ report sublist xs 0 n ]
  report sentence xs n-values (n - length xs) [ last xs ]
end

to-report cycle-fill [xs n]
  if empty? xs [ report n-values n [ 0 ] ]
  let k length xs
  let out []
  let i 0
  repeat n [
    set out lput item (i mod k) xs out
    set i i + 1
  ]
  report out
end

to-report coerce-number [v]
  let parsed coerce-number-or-none v
  ifelse is-number? parsed [ report parsed ] [ report 0 ]
end

to-report coerce-number-or-none [v]
  if is-number? v [ report v ]
  if is-string? v [
    if v = "" or v = "null" or v = "None" [ report false ]
    let parsed 0
    let ok? true
    carefully [ set parsed read-from-string v ] [ set ok? false ]
    if ok? and is-number? parsed [ report parsed ]
    report false
  ]
  report false
end

;; ---------- BehaviorSpace reporters (post burn-in) ----------

to-report peak-occupancy
  report peak-so-far
end

to-report pct-slots-over-capacity
  if n-slots-recorded = 0 [ report 0 ]
  report 100 * n-slots-over / n-slots-recorded
end

to-report occupancy-variance
  if not is-list? all-slot-attendance [ report 0 ]
  if length all-slot-attendance < 2 [ report 0 ]
  let mu mean all-slot-attendance
  report mean map [ x -> (x - mu) * (x - mu) ] all-slot-attendance
end

to-report good-visit-rate
  if n-visits = 0 [ report 0 ]
  report n-good-visits / n-visits
end

to-report skip-rate
  if n-agent-days = 0 [ report 0 ]
  report n-skips / n-agent-days
end

to-report lag1-autocorr
  if not is-list? all-slot-attendance [ report 0 ]
  if length all-slot-attendance < 3 [ report 0 ]
  let pair-indices filter [i -> (i + 1) mod n-slots != 0] (range (length all-slot-attendance - 1))
  if length pair-indices < 2 [ report 0 ]
  let xs map [i -> item i all-slot-attendance] pair-indices
  let ys map [i -> item (i + 1) all-slot-attendance] pair-indices
  let mx mean xs
  let my mean ys
  let num sum (map [ [ x y ] -> (x - mx) * (y - my) ] xs ys)
  let ss-x sum map [ x -> (x - mx) * (x - mx) ] xs
  let ss-y sum map [ y -> (y - my) * (y - my) ] ys
  if ss-x * ss-y = 0 [ report 0 ]
  report num / sqrt (ss-x * ss-y)
end

to-report current-slot-label
  if not is-list? slot-labels [ report "--" ]
  if current-slot >= length slot-labels [ report "--" ]
  report item current-slot slot-labels
end

;; ---------- original El Farol strategy machinery (unchanged) ----------

;; determines which strategy would have predicted the best results had it been used this round.
;; the best strategy is the one that has the sum of smallest differences between the
;; current attendance and the predicted attendance for each of the preceding
;; weeks (going back MEMORY-SIZE weeks)
;; this does not change the strategies at all, but it does (potentially) change the one
;; currently being used and updates the performance of all strategies
to update-strategies
  ;; initialize best-score to a maximum, which is the lowest possible score
  let best-score 1.0E20
  foreach strategies [ the-strategy ->
    let score 0
    let week 1
    repeat memory-size [
      set prediction predict-attendance the-strategy sublist history week (week + memory-size)
      set score score + abs (item (week - 1) history - prediction)
      set week week + 1
    ]
    if (score <= best-score) [
      set best-score score
      set best-strategy the-strategy
    ]
  ]
end

;; this reports a random strategy. a strategy is just a set of weights from -1.0 to 1.0 which
;; determines how much emphasis is put on each previous time period when making
;; an attendance prediction for the next time period
to-report random-strategy
  report n-values (memory-size + 1) [1.0 - model-random * 2.0]
end

;; This reports an agent's prediction of the current attendance
;; using a particular strategy and portion of the attendance history.
;; More specifically, the strategy is then described by the formula
;; p(t) = x(t - 1) * a(t - 1) + x(t - 2) * a(t -2) +..
;;      ... + x(t - MEMORY-SIZE) * a(t - MEMORY-SIZE) + c * 100,
;; where p(t) is the prediction at time t, x(t) is the attendance of the bar at time t,
;; a(t) is the weight for time t, c is a constant, and MEMORY-SIZE is an external parameter.
to-report predict-attendance [strategy subhistory]
  ;; the first element of the strategy is the constant, c, in the prediction formula.
  ;; one can think of it as the the agent's prediction of the bar's attendance
  ;; in the absence of any other data
  ;; then we multiply each week in the history by its respective weight
  report n-agents * first strategy + sum (map [ [weight week] -> weight * week ] butfirst strategy subhistory)
end

;; In this model it doesn't really matter exactly which patch
;; a turtle is on, only whether the turtle is in the home area
;; or the gym area.  Nonetheless, to make a nice visualization
;; this procedure is used to ensure that we only have one
;; turtle per patch.
to move-to-empty-one-of [locations]  ;; turtle procedure
  let empties locations with [ not any? turtles-here ]
  ifelse any? empties
    [ move-to one-of empties ]
    [ if any? locations [ move-to one-of locations ] ]
end

; Copyright 2007 Uri Wilensky. Gym-slot extension 2026.
; See Info tab for full copyright and license.
]]></code>
  <widgets>
    <view x="300" wrappingAllowedX="true" y="10" frameRate="30.0" minPycor="-17" height="424" showTickCounter="true" patchSize="12.0" fontSize="14" wrappingAllowedY="true" width="424" tickCounterLabel="ticks" maxPycor="17" updateMode="1" maxPxcor="17" minPxcor="-17"></view>
    <slider x="10" step="1" y="10" max="200" width="270" display="n-agents" height="50" min="10" direction="Horizontal" default="100.0" variable="n-agents"></slider>
    <slider x="10" step="1" y="60" max="100" width="270" display="capacity" height="50" min="1" direction="Horizontal" default="37.0" variable="capacity"></slider>
    <slider x="10" step="1" y="110" max="10" width="270" display="memory-size" height="50" min="1" direction="Horizontal" default="5.0" variable="memory-size"></slider>
    <slider x="10" step="1" y="160" max="20" width="270" display="number-strategies" height="50" min="1" direction="Horizontal" default="10.0" variable="number-strategies"></slider>
    <slider x="10" step="1" y="210" max="6" width="270" display="delay" height="50" min="1" direction="Horizontal" default="2.0" variable="delay"></slider>
    <slider x="10" step="1" y="260" max="20" width="270" display="burn-in-days" height="50" min="0" direction="Horizontal" default="10.0" variable="burn-in-days"></slider>
    <chooser x="10" y="310" height="60" variable="info-mode" current="0" width="270" display="info-mode">
      <choice type="string" value="none"></choice>
      <choice type="string" value="live"></choice>
      <choice type="string" value="delayed"></choice>
    </chooser>
    <switch x="10" y="375" height="40" on="false" variable="must-go?" width="130" display="must-go?"></switch>
    <switch x="150" y="375" height="40" on="true" variable="seed-from-data?" width="130" display="seed-from-data?"></switch>
    <switch x="10" y="475" height="40" on="true" variable="visualize?" width="130" display="visualize?"></switch>
    <button x="10" y="425" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="80" display="setup">setup</button>
    <button x="100" y="425" height="40" disableUntilTicks="true" forever="true" kind="Observer" width="80" display="go">go</button>
    <button x="190" y="425" height="40" disableUntilTicks="true" forever="false" kind="Observer" width="90" display="go-day">go-day</button>
    <monitor x="735" precision="0" y="10" height="55" fontSize="11" width="140" display="day">current-day</monitor>
    <monitor x="880" precision="0" y="10" height="55" fontSize="11" width="140" display="slot">current-slot</monitor>
    <monitor x="735" precision="0" y="70" height="55" fontSize="11" width="140" display="attendance">attendance</monitor>
    <monitor x="880" precision="0" y="70" height="55" fontSize="11" width="140" display="time">current-slot-label</monitor>
    <monitor x="735" precision="1" y="130" height="55" fontSize="11" width="140" display="peak-occupancy">peak-occupancy</monitor>
    <monitor x="880" precision="1" y="130" height="55" fontSize="11" width="140" display="pct-over-cap">pct-slots-over-capacity</monitor>
    <monitor x="735" precision="2" y="190" height="55" fontSize="11" width="140" display="occupancy-var">occupancy-variance</monitor>
    <monitor x="880" precision="3" y="190" height="55" fontSize="11" width="140" display="lag1-autocorr">lag1-autocorr</monitor>
    <monitor x="735" precision="3" y="250" height="55" fontSize="11" width="140" display="good-visit-rate">good-visit-rate</monitor>
    <monitor x="880" precision="3" y="250" height="55" fontSize="11" width="140" display="skip-rate">skip-rate</monitor>
    <plot x="300" autoPlotX="true" yMax="100.0" autoPlotY="true" yAxis="Occupancy" y="445" xMin="0.0" height="200" legend="true" xMax="10.0" yMin="0.0" width="424" xAxis="Slot ticks" display="Gym occupancy">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="occupancy" color="-16777216" legend="true">
        <setup></setup>
        <update>plot attendance</update>
      </pen>
      <pen interval="1.0" mode="0" display="capacity" color="-2674135" legend="true">
        <setup></setup>
        <update>plot-pen-reset
plotxy 0 capacity
plotxy plot-x-max capacity</update>
      </pen>
    </plot>
    <plot x="735" autoPlotX="false" yMax="100.0" autoPlotY="true" yAxis="Occupancy" y="315" xMin="0.0" height="190" legend="false" xMax="31.0" yMin="0.0" width="285" xAxis="Slot" display="Today by slot">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="1" display="today" color="-13345367" legend="true">
        <setup></setup>
        <update>plot-pen-reset
if is-list? today-attendance [
  let i 0
  foreach today-attendance [ a -&gt;
    plotxy i a
    set i i + 1
  ]
]</update>
      </pen>
      <pen interval="1.0" mode="0" display="capacity" color="-2674135" legend="true">
        <setup></setup>
        <update>plot-pen-reset
plotxy 0 capacity
plotxy plot-x-max capacity</update>
      </pen>
    </plot>
    <input x="1040" y="10" width="175" height="60" variable="population-seed" type="number" multiline="false">42</input>
    <input x="1040" y="80" width="175" height="60" variable="simulation-seed" type="number" multiline="false">1234</input>
    <slider x="1040" y="150" width="175" height="50" display="workout-slots" variable="workout-slots" min="1" max="6" step="1" default="2.0" direction="Horizontal"></slider>
  </widgets>
  <info><![CDATA[
# Individual gym schedules and preferences

Implemented from the group input confirmed on November 9, 2026. The default population is 100 agents. Each agent has one availability group, time preference, flexibility level, and crowding preference. These are modeling assumptions, not surveyed student schedules.

## Confirmed profiles

| Availability group | Allowed workout windows |
| --- | --- |
| 1 | 06:30-09:00 and 17:00-22:00 |
| 2 | 09:00-12:00 and 14:00-22:00 |
| 3 | 06:30-22:00 |
| 4 | 10:00-15:00 and 18:00-21:00 |

Time preferences are Morning (06:30-12:00), Night (17:00-22:00), Afternoon (12:00-17:00), and Whenever. Preference applies to the workout **start**, with the end of each preferred period exclusive. Flexibility extends the preferred start period by one hour, three hours, zero, or any available time. For example, a morning agent with one-hour flexibility may start as late as 12:30. Availability always takes priority.

Workouts last one hour, or two half-hour slots. The complete workout must fit inside one availability window and end by closing. An 08:30 start cannot cross group 1's 09:00 boundary. A workout cannot bridge the gap between two windows. The last possible gym-wide start is 21:00.

Crowding types are No difference, Likes it busy, and Likes it empty. They rank feasible predicted loads differently, but none deliberately chooses a forecast above capacity under the default `must-go? = false` setting. Simultaneous decisions can still produce actual over-capacity occupancy. Physical capacity is common to all agents.

The canonical profile definitions are `web/profile-rules.csv`. Both implementations read this file. Browser seed history is served directly from `netlogo/seed_history.csv`; it is not a second hard-coded copy.

## Decision rule

At each slot, agents whose workout has ended leave first. Agents who have not visited consider their remaining allowed start slots:

1. The current slot's prediction comes from that agent's best linear predictor, with the existing 50/50 live or delayed information blend. A missing early-day information signal falls back to the inductive prediction.
2. Future candidate slots use their historical mean over the chosen memory length. Agents never see future actual occupancy. These estimates are refreshed when the next slot is reached.
3. Predictions are bounded to zero through population size. Starts predicted to exceed capacity are excluded.
4. Candidate score is `crowding direction * predicted occupancy / capacity - time cost`. Direction is 0 for indifferent, +1 for busy-seeking, and -1 for quiet-seeking. Time cost is the distance outside the preferred start period divided by the flexibility allowance. Unlimited flexibility uses the 930-minute operating span; Whenever has zero time cost. This equal weighting is an explicit implementation assumption.
5. The agent attends if the current slot is its highest-scoring remaining candidate; otherwise it waits. Fixed, independently generated per-agent slot priorities break ties and prevent shared labels from forcing identical choices.

Zero-flexibility agents never start outside their preferred period. Unlimited flexibility allows movement within availability while preserving a soft preference for the named period. An agent with no feasible start skips; its availability is not silently changed. `must-go?`, if deliberately enabled in NetLogo, forces attendance only at that agent's final allowed start, never outside availability.

## Occupancy and visit accounting

Agents remain in the gym for exactly two slots and can start at most one workout per day. They contribute to occupancy in both occupied slots. A successful visit must remain at or below capacity throughout the workout. A crowded first slot cannot be overwritten by a quieter later slot. Each visit or skip is counted once at day end. Lag-1 autocorrelation excludes overnight closing-to-opening pairs, matching the real-data calibration convention.

This fixes the prior NetLogo behavior in which `attend?` remained true until the next day. Old pilot results therefore do not validate the new model.

## Balanced and reproducible populations

There are 4 x 4 x 4 x 3 = 192 possible profile combinations. With 100 agents, the default allocation is:

- 25 agents per availability group;
- 25 per time preference, with six or seven of each preference inside each availability group;
- 25 per flexibility level;
- 33 or 34 per crowding type.

Assignments are randomized subject to these marginal counts. This does not fully balance all 192 joint combinations. The population seed controls profile assignments and tie priorities, independently of the strategy seed and memory length. Attributes stay fixed throughout a run. Both implementations use the same specified Park-Miller generator for profiles and linear-strategy weights so matching configurations can be checked directly.

BehaviorSpace varies population seeds 1-5 for the pilot and 1-30 for the full grid, with one run per explicit seed per condition. Strategy seed is `100000 + population-seed`. Thus the same population is reused across information and memory conditions: 45 pilot runs and 270 full-grid runs. Each run lasts 40 days; the first 10 are discarded. Population and strategy seeds are recorded in the output. Use a new population seed to explore a new assignment; do not change it when comparing conditions for the same replicate.

In the browser, select an agent for its complete profile and allowed starts. Download agent profiles to retain the exact assignments, rules, and tie priorities. In the NetLogo Command Center, `export-agent-profiles "profiles.csv"` exports the current assignment.

## Running and verifying

From the repository root:

```text
python web/server.py
node --test tests/simulation.test.js
python tests/check_model_config.py
python analysis/run_pilot.py --smoke
python analysis/run_pilot.py --experiment info-memory-pilot --threads 4
node tests/check_netlogo_parity.js data/processed/preferences_pilot.csv
```

The browser runs at http://127.0.0.1:8000. Use Reset to replay the same seeds. Changing information, memory, population size, capacity, days, or seeds resets the run. The browser stops after exactly the requested number of days. Speed changes do not reset the experiment.

Open `netlogo/GymElFarol.nlogox` with NetLogo 7.0.4. The older `.nlogo` file is retained as a legacy version and does not contain these changes. The runner accepts `--netlogo PATH` or `NETLOGO_HOME` if NetLogo is not in its usual installation directory. It stages the include file and shared CSV rules alongside the model.

New results use `preferences_smoke.csv`, `preferences_pilot.csv`, or `preferences_info-memory-grid.csv`. Run metadata is stored beside each table as `.meta.json`, including hashes of the model, include, rule CSV, and seed CSV. The original pilot CSV and summary are retained as historical artifacts. `analysis/analyze_pilot.py` remains the older slot-model decision analysis; its fixed narrative and default output names should not be used as the new preference experiment report.

## Research limitations to resolve before conclusions

The existing default capacity of 37 and population of 100 are retained. They were calibrated before explicit one-hour duration and availability constraints were introduced. The per-day occupancy budget is now at most 200 occupied agent-slots, while the real-data seed profile sums to about 705 scaled occupied agent-slots. Initial history can seed learning but cannot resolve that structural mismatch. Review the population/duration calibration before claiming realistic crowding levels or validation against real counts. Do not tune capacity solely to manufacture a desired information effect.

Balanced profile proportions and the choice-score weighting are assumptions. Later sensitivity analyses can vary them. The existing Word report and progress summary still contain older model descriptions and should be updated by the group to describe the final implementation and its limitations.

## Credits and license

Adapted from Rand, W., Wilensky, U. (2007). NetLogo El Farol model. http://ccl.northwestern.edu/netlogo/models/ElFarol

Arthur, W. B. (1994). Inductive reasoning and bounded rationality. American Economic Review 84(2), 406-411.

Fogel, D. B., Chellapilla, K., and Angeline, P. J. (1999). Inductive reasoning and bounded rationality reconsidered. IEEE Transactions on Evolutionary Computation 3(2), 142-146.

The original El Farol model is Copyright 2007 Uri Wilensky, CC BY-NC-SA 3.0. This course extension retains its linear-predictor learning approach and modifies random generation, population scaling, scheduling, information, and visit accounting.
