<experiments>
    <experiment name="info-memory-pilot" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="false" timeLimit="1240">
      <setup>set simulation-seed 100000 + population-seed setup</setup>
      <go>go</go>
      <metrics>
        <metric>peak-occupancy</metric>
